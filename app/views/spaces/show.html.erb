<div class="page-container">
  <div class="row g-5">
    <div class="col-md-7">
      <img
        src="<%= @space.photo.attached? ? cl_image_path(@space.photo.key) : 'https://a0.muscache.com/im/pictures/miso/Hosting-47118372/original/7cb880ec-a5f7-4131-9174-d4e1b124bb67.jpeg' %>"
        alt="<%= @space.name %>"
        style="width: 100%; height: 320px; object-fit: cover; border-radius: 14px; margin-bottom: 2rem;">

      <h1 style="font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 600; margin-bottom: 0.5rem;"><%= @space.name %></h1>
      <p style="color: #767676; margin-bottom: 1.5rem;"><i class="fas fa-map-marker-alt me-2"></i><%= @space.location %></p>

      <div style="border-top: 1px solid #E4E4E0; padding-top: 1.5rem; margin-bottom: 1.5rem;">
        <p style="color: #1A1A1A; line-height: 1.75;"><%= @space.description %></p>
      </div>

      <div class="d-flex gap-4 flex-wrap">
        <div class="space-stat">
          <span class="stat-value">€<%= @space.price_per_hour %></span>
          <span class="stat-label">per hour</span>
        </div>
        <div class="space-stat">
          <span class="stat-value">€<%= @space.price_per_day %></span>
          <span class="stat-label">per day</span>
        </div>
        <div class="space-stat">
          <span class="stat-value"><i class="fa-solid fa-user"></i> <%= @space.capacity %></span>
          <span class="stat-label">capacity</span>
        </div>
        <div class="space-stat">
          <span class="stat-value">
            <span class="availability-dot <%= @space.availability_status ? 'dot-available' : 'dot-unavailable' %>"></span>
            <%= @space.availability_status ? "Available" : "Unavailable" %>
          </span>
          <span class="stat-label">status</span>
        </div>
      </div>
    </div>

    <div class="col-md-5">
      <% if current_user&.role == "renter" %>
        <div class="booking-card">
          <h3>Book this space</h3>
          <%= simple_form_for [@space, @booking] do |f| %>
            <div class="mb-3">
              <%= f.input :start_date, label: "Start date", input_html: { class: "form-control" } %>
            </div>
            <div class="mb-3">
              <%= f.input :end_date, label: "End date", input_html: { class: "form-control" } %>
            </div>
            <%= f.button :submit, "Confirm booking", class: "btn btn-primary w-100" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to "← Back to spaces", spaces_path, class: "back-link" %>
  </div>
</div>
