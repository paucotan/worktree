<div class="spaces-hero">
  <div class="spaces-hero-inner">
    <span class="hero-tag">Coworking spaces</span>
    <h1 class="hero-title">Find your perfect<br>place to work</h1>
    <p class="hero-sub">Book unique coworking spaces by the hour or day.</p>
  </div>
</div>

<div class="page-container">
  <% if @spaces.any? %>
    <div class="row g-4">
      <% @spaces.each do |space| %>
        <div class="col-lg-4 col-md-6">
          <%= link_to space_path(space), class: "text-decoration-none" do %>
            <div class="card h-100">
              <%= cl_image_tag space.photo.key, class: 'card-img-top' %>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= space.name %></h5>
                <p class="card-text"><i class="fas fa-map-marker-alt me-1"></i><%= space.location %></p>
                <div class="d-flex justify-content-between align-items-center mt-auto pt-3" style="border-top: 1px solid #f0f0ed;">
                  <span style="font-weight: 600; color: #1A1A1A; font-size: 0.95rem;">
                    €<%= space.price_per_day %> <span style="font-weight: 400; color: #767676; font-size: 0.8rem;">/ day</span>
                  </span>
                  <span style="font-size: 0.8rem; color: #767676;"><i class="fa-solid fa-user me-1"></i><%= space.capacity %></span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <i class="fas fa-building empty-icon"></i>
      <h3>No spaces yet</h3>
      <p>Be the first to list a coworking space.</p>
      <% if current_user&.owner? %>
        <%= link_to "Add a space", new_space_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
