<div class="page-container">
  <div class="page-header">
    <h1>Dashboard</h1>
    <p>Welcome back, <%= current_user.email %></p>
  </div>

  <% if current_user.owner? %>
    <div class="row g-5">
      <div class="col-md-6">
        <div class="section-header">
          <h2 class="section-title">Your Spaces</h2>
          <%= link_to "+ Add space", new_space_path, class: "btn btn-primary btn-sm" %>
        </div>
        <div class="row g-3">
          <% current_user.spaces.each do |space| %>
            <div class="col-12">
              <div class="card position-relative">
                <%= cl_image_tag space.photo.key, class: "card-img-top" %>
                <%= button_to space_path(space), method: :delete, data: { confirm: 'Are you sure?' }, class: "transparent-delete-btn position-absolute top-0 end-0 m-2" do %>
                  <i class="fa-solid fa-trash"></i>
                <% end %>
                <div class="card-body">
                  <h5 class="card-title"><%= space.name %></h5>
                  <p class="card-text"><%= space.location %></p>
                  <%= link_to "View details", space_path(space), class: "btn btn-outline-dark btn-sm mt-1" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="section-header">
          <h2 class="section-title">Bookings</h2>
        </div>
        <div class="row g-3">
          <% @bookings.each do |booking| %>
            <div class="col-12">
              <div class="card position-relative">
                <%= cl_image_tag booking.space.photo.key, class: "card-img-top" %>
                <% if booking.space.owner == current_user %>
                  <%= button_to booking_path(booking), method: :delete, data: { confirm: 'Are you sure?' }, class: "transparent-delete-btn position-absolute top-0 end-0 m-2" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                <% end %>
                <div class="card-body">
                  <h5 class="card-title"><%= booking.space.name %></h5>
                  <p class="card-text">
                    <span class="booking-meta">Renter:</span> <%= booking.renter.email %>
                  </p>
                  <p class="card-text">
                    <span class="booking-meta">Dates:</span>
                    <%= booking.start_date.strftime("%d %b %Y") %> – <%= booking.end_date.strftime("%d %b %Y") %>
                  </p>
                  <div class="d-flex align-items-center justify-content-between mt-2">
                    <span class="status-badge status-<%= booking.status %>"><%= booking.status %></span>
                    <% if booking.status == 'pending' %>
                      <div class="d-flex gap-2">
                        <%= button_to accept_booking_path(booking), method: :patch, class: "btn btn-primary btn-sm" do %>
                          <i class="fas fa-check"></i> Accept
                        <% end %>
                        <%= button_to decline_booking_path(booking), method: :patch, class: "btn btn-danger btn-sm" do %>
                          <i class="fas fa-times"></i> Decline
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  <% elsif current_user.renter? %>
    <div class="section-header">
      <h2 class="section-title">Your Bookings</h2>
    </div>
    <div class="row g-4">
      <% @bookings.each do |booking| %>
        <div class="col-md-4">
          <div class="card h-100">
            <%= cl_image_tag booking.space.photo.key, class: "card-img-top" %>
            <div class="card-body">
              <h5 class="card-title"><%= booking.space.name %></h5>
              <p class="card-text">
                <%= booking.start_date.strftime("%d %b %Y") %> – <%= booking.end_date.strftime("%d %b %Y") %>
              </p>
              <span class="status-badge status-<%= booking.status %>"><%= booking.status %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
