<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h1>Welcome back</h1>
      <p>Sign in to your Worktree account</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email, required: false, autofocus: true,
          label: "Email",
          input_html: { autocomplete: "email", class: "form-control", placeholder: "you@example.com" } %>
      <%= f.input :password, required: false,
          label: "Password",
          input_html: { autocomplete: "current-password", class: "form-control", placeholder: "••••••••" } %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      <%= f.button :submit, "Sign in", class: "btn btn-primary w-100 mt-2" %>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
